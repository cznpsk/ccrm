#!/usr/bin/env bash
# ccrm — จัดการ sessions ของ Claude Code + Codex + Kimi + Gemini แบบ interactive (fzf)
# รองรับ macOS (bash/zsh) และ Linux/WSL
# ใช้: ccrm → Claude ทุก project + Codex/Kimi/Gemini ทั้งหมด
# คีย์: Enter=resume session ที่เลือก
#       Tab=เลือกจะลบ, กด Tab อีกครั้งบนบรรทัดเดิม=ยืนยันลบ
#       Esc=ยกเลิก
# หมายเหตุ gemini: --resume ของตัว CLI เองรับแค่ "latest"/index ผูกกับ project ปัจจุบัน
#   ไม่มี resume-by-id ตรงๆ เลยใช้ --session-file แทน (ต้อง cd เข้า project เดิมก่อนเสมอ)
set -uo pipefail

ver=19
raw="https://raw.githubusercontent.com/cznpsk/ccrm/main"

if [[ "${1:-}" == "update" ]]; then
  # ?ts= กัน CDN cache ของ raw.githubusercontent (แคช ~5 นาที)
  exec bash -c "curl -fsSL '$raw/install.sh?ts=$(date +%s)' | bash"
fi

# เช็คเวอร์ชันใหม่แบบ background ไม่บล็อกการใช้งาน — ผลไปโผล่ครั้งถัดไป
ver_cache="$HOME/.cache/ccrm-latest"
mkdir -p "$HOME/.cache"
( curl -fsSL --max-time 3 "$raw/VERSION?ts=$(date +%s)" -o "$ver_cache.tmp" 2>/dev/null && mv "$ver_cache.tmp" "$ver_cache" ) &
latest=$(cat "$ver_cache" 2>/dev/null | tr -d '[:space:]')
update_note=""
[[ "$latest" =~ ^[0-9]+$ ]] && (( latest > ver )) && update_note="  |  ⬆ v$latest มาแล้ว"

base="$HOME/.claude/projects"
os="$(uname)"

if [[ "$os" == "Darwin" ]]; then
  _mtime_epoch() { stat -f '%m' "$1"; }
  _mtime_fmt()   { stat -f '%Sm' -t '%d/%m %H:%M' "$1"; }
  _size_bytes()  { stat -f '%z' "$1"; }
else
  _mtime_epoch() { stat -c '%Y' "$1"; }
  _mtime_fmt()   { date -d "@$(stat -c '%Y' "$1")" '+%d/%m %H:%M'; }
  _size_bytes()  { stat -c '%s' "$1"; }
fi

label_of() {
  local f="$1" t=""
  case "$f" in
    */.codex/*)
      local id
      id=$(basename "$f" | grep -oE '[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}')
      t=$(grep -F "\"$id\"" "$HOME/.codex/session_index.jsonl" 2>/dev/null | tail -1 | jq -r '.thread_name // empty' 2>/dev/null)
      if [[ -z "$t" ]]; then
        t=$(head -c 500000 "$f" | jq -r 'select(.type=="response_item" and .payload.role=="user") | .payload.content[]? | select(.type=="input_text") | .text | select(startswith("<")|not)' 2>/dev/null \
            | head -1)
      fi
      t="${t:0:70}"
      ;;
    */.kimi-code/*)
      t=$(jq -r '.title // empty' "$f" 2>/dev/null)
      if [[ -z "$t" || "$t" == "New Session" ]]; then
        t=$(jq -r 'select(.type=="turn.prompt" and .origin.kind=="user") | .input[]? | select(.type=="text") | .text' "$(dirname "$f")/agents/main/wire.jsonl" 2>/dev/null | head -1)
      fi
      t="${t:0:70}"
      ;;
    */.gemini/*)
      t=$(jq -r '.messages[]? | select(.type=="user") | .content[]? | select(.text) | .text' "$f" 2>/dev/null | head -1)
      t="${t:0:70}"
      ;;
    *)
      t=$(grep -o '"customTitle":"[^"]*"' "$f" 2>/dev/null | tail -1 | sed 's/"customTitle":"//;s/"$//')
      if [[ -z "$t" ]]; then
        t=$(head -c 300000 "$f" | jq -r 'select(.type=="user" and (.isMeta!=true)) | .message.content | if type=="string" then . else ([.[]|select(.type=="text")|.text]|join(" ")) end' 2>/dev/null \
            | grep -v '^<' | head -1 | cut -c1-70)
      fi
      ;;
  esac
  echo "${t:-(ว่าง)}"
}

_list() {
  local claude_files codex_files kimi_files gemini_files files
  claude_files=$(find "$base" -mindepth 2 -maxdepth 2 -name '*.jsonl' -type f 2>/dev/null)
  codex_files=$(find "$HOME/.codex/sessions" "$HOME/.codex/archived_sessions" -name '*.jsonl' -type f 2>/dev/null)
  kimi_files=$(find "$HOME/.kimi-code/sessions" -mindepth 3 -maxdepth 3 -name 'state.json' -type f 2>/dev/null)
  gemini_files=$(find "$HOME/.gemini/tmp" -mindepth 2 -path '*/chats/*' -name '*.json' -type f 2>/dev/null)
  files=$(printf '%s\n%s\n%s\n%s\n' "$claude_files" "$codex_files" "$kimi_files" "$gemini_files" | grep -v '^$')
  [[ -n "$files" ]] || return 0

  # cache ชื่อ session ตาม path+mtime — ไฟล์ใหญ่หลักร้อย MB สแกนหา customTitle ครั้งเดียวพอ
  local label_cache="$HOME/.cache/ccrm-labels.tsv"
  mkdir -p "$HOME/.cache"; touch "$label_cache"
  # codex rename เขียนแค่ session_index.jsonl ไม่แตะไฟล์ session — ผูก key กับ mtime ของ index ด้วย
  local codex_idx_ep=""
  [[ -f "$HOME/.codex/session_index.jsonl" ]] && codex_idx_ep=$(_mtime_epoch "$HOME/.codex/session_index.jsonl")

  # sort ตาม mtime ก่อน (stat อย่างเดียว เร็ว) แล้วค่อยทยอยคำนวณ label — จะได้ stream ออกทีละแถวแบบเรียงแล้ว
  local files_sorted
  files_sorted=$(while IFS= read -r f; do
    [[ -e "$f" ]] && printf '%s\t%s\n' "$(_mtime_epoch "$f")" "$f"
  done <<< "$files" | sort -rn)

  while IFS=$'\t' read -r ep f; do
    [[ -n "$f" ]] || continue
    case "$f" in
      */.codex/*)     tag="codex "; out="$f" ;;
      */.kimi-code/*) tag="kimi  "; out="$(dirname "$f")" ;;
      */.gemini/*)    tag="gemini"; out="$f" ;;
      *)              tag="claude"; out="$f" ;;
    esac
    case "$tag" in
      claude) ck=$(_size_bytes "$f") ;;        # jsonl append-only — key ตาม size ไว้สแกนเฉพาะส่วนงอก
      "codex ") ck="$ep-$codex_idx_ep" ;;
      *) ck="$ep" ;;
    esac
    lbl=$(grep -F "$f"$'\t'"$ck"$'\t' "$label_cache" | head -1 | cut -f3-)
    if [[ -z "$lbl" ]]; then
      if [[ "$tag" == "claude" ]]; then
        # ไฟล์โตจากรอบก่อน — สแกนหา customTitle เฉพาะ byte ที่งอกใหม่ ไม่อ่านทั้งไฟล์ซ้ำ
        prev=$(grep -F "$f"$'\t' "$label_cache" | tail -1)
        prev_sz=$(printf '%s' "$prev" | cut -f2)
        if [[ "$prev_sz" =~ ^[0-9]+$ ]] && [[ "$prev_sz" -lt "$ck" ]]; then
          nt=$(tail -c "+$((prev_sz+1))" "$f" 2>/dev/null | grep -o '"customTitle":"[^"]*"' | tail -1 | sed 's/"customTitle":"//;s/"$//')
          nt="${nt:0:70}"
          lbl="${nt:-$(printf '%s' "$prev" | cut -f3-)}"
        fi
      fi
      [[ -n "$lbl" ]] || lbl=$(label_of "$f" | tr '\t\n' '  ')
      printf '%s\t%s\t%s\n' "$f" "$ck" "$lbl" >> "$label_cache"
    fi
    sz=$(du -sh "$out" 2>/dev/null | cut -f1)
    dt=$(_mtime_fmt "$f")
    printf '%s\t%s\t%s\t%7s\t%s\n' "$out" "$tag" "$dt" "$sz" "$lbl"
  done <<< "$files_sorted"

  # กัน cache โตไม่จำกัด
  if [[ $(wc -l < "$label_cache") -gt 5000 ]]; then
    tail -2000 "$label_cache" > "$label_cache.tmp" && mv "$label_cache.tmp" "$label_cache"
  fi
}

if [[ "${1:-}" == "--list" ]]; then
  _list "${2:-}"
  exit 0
fi

# มีเวอร์ชันใหม่ — เมนูเลือกก่อนเปิด (ลูกศรขึ้นลง + Enter, Esc = ข้าม)
if [[ -n "$update_note" ]]; then
  choice=$(printf 'อัพเดทเป็น v%s เลย\nข้ามไปก่อน (ใช้ v%s ต่อ)\n' "$latest" "$ver" \
    | fzf --header="⬆ มีเวอร์ชันใหม่ของ ccrm" --no-multi --reverse --no-info --height=~6 --prompt='เลือก> ')
  if [[ "$choice" == อัพเดท* ]]; then
    curl -fsSL "$raw/install.sh?ts=$(date +%s)" | bash
    exec "$HOME/.local/bin/ccrm"
  fi
fi

reload_cmd="$0 --list ${1:-}"
hdr="Enter=resume  Tab=เลือกลบ (กด Tab อีกครั้งยืนยัน)  Ctrl-A=รีเฟรช  Esc=ยกเลิก$update_note"

# stream เข้า fzf ตรงๆ — UI เปิดทันที รายการทยอยขึ้นระหว่างสแกน (|| true กัน SIGPIPE ตอนผู้ใช้เลือกก่อนสแกนจบ)
picked=$({ _list "${1:-}" 2>/dev/null || true; } | fzf --multi --delimiter=$'\t' --with-nth=2.. \
  --header="กำลังโหลด...  |  $hdr" \
  --bind "load:transform-header:echo \"รวม \$FZF_TOTAL_COUNT sessions  |  $hdr\"" \
  --preview 'f={1}; case "$f" in
    */.codex/*) head -c 500000 "$f" | jq -r "select(.type==\"response_item\" and .payload.role==\"user\") | .payload.content[]? | select(.type==\"input_text\") | .text | select(startswith(\"<\")|not)" 2>/dev/null ;;
    */.kimi-code/*) jq -r "select(.type==\"turn.prompt\" and .origin.kind==\"user\") | .input[]? | select(.type==\"text\") | .text" "$f/agents/main/wire.jsonl" 2>/dev/null ;;
    */.gemini/*) jq -r ".messages[]? | select(.type==\"user\") | .content[]? | select(.text) | .text" "$f" 2>/dev/null ;;
    *) head -c 300000 "$f" | jq -r "select(.type==\"user\" and (.isMeta!=true)) | .message.content | if type==\"string\" then . else ([.[]|select(.type==\"text\")|.text]|join(\" \")) end" 2>/dev/null ;;
  esac | grep -v "^<" | head -30' \
  --preview-window=right:50%:wrap \
  --bind "ctrl-a:reload($reload_cmd)" \
  --bind "tab:transform:if [ \"\$FZF_SELECT_COUNT\" -gt 0 ] && [ {+1} = {1} ]; then echo \"execute-silent(rm -rf {1})+reload($reload_cmd)+clear-selection\"; else echo 'clear-selection+toggle'; fi") || exit 0

[[ -n "$picked" ]] || exit 0

spath=$(echo "$picked" | cut -f1)
tag=$(echo "$picked" | cut -f2 | tr -d ' ')

case "$tag" in
  codex)
    id=$(basename "$spath" | grep -oE '[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}')
    exec codex resume "$id" --yolo
    ;;
  kimi)
    id=$(basename "$spath")
    workdir=$(jq -r '.cwd // .workDir // empty' "$spath/state.json" 2>/dev/null)
    [[ -n "$workdir" ]] && cd "$workdir"
    exec kimi -r "$id" --yolo
    ;;
  gemini)
    projdir=$(dirname "$(dirname "$spath")")
    root=$(cat "$projdir/.project_root" 2>/dev/null)
    [[ -n "$root" ]] && cd "$root"
    exec gemini --session-file "$spath" -y
    ;;
  *)
    id=$(basename "$spath" .jsonl)
    exec claude --resume "$id" --dangerously-skip-permissions
    ;;
esac
